# AITutor infrastructure secrets - TEMPLATE ONLY (placeholder values).
#
# Copy this file to .env in this directory and replace every placeholder.
# The real .env must never be committed (root .gitignore excludes it).

# Bootstrap superuser of the PostgreSQL container (initialisation only;
# never used as an application account and never written to the repo).
POSTGRES_BOOTSTRAP_PASSWORD=replace-me-bootstrap-strong-password

# Application role qcore_app (created by initdb/01-init-qcore.sh).
QCORE_APP_PASSWORD=replace-me-app-strong-password

# MinIO root credentials.
MINIO_ROOT_USER=aitutor_minio_admin
MINIO_ROOT_PASSWORD=replace-me-minio-strong-password

# Redis requirepass.
REDIS_PASSWORD=replace-me-redis-strong-password
