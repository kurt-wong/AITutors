{
  "contract_version": "qcore-dt-knowledge-contract/v1",
  "status": "design_only",
  "principles": [
    "QCore owns global question, revision, knowledge node, and mapping facts",
    "DeepTutor owns learning goals, paths, attempts, evidence, mastery, and scheduling",
    "The integration layer owns only versioned links and read-only projections",
    "KnowledgePoint.id is never replaced by a QCore node_id",
    "One knowledge point may link to many canonical nodes and vice versa",
    "Historical evidence is interpreted under the mapping version active at that time",
    "Ungraded evidence never contributes to correctness, error, or mastery"
  ],
  "entities": {
    "QCoreKnowledgeNode": {
      "owner": "qcore",
      "identity": "node_id",
      "namespace": "existing node ids (my:, mml:, goralcao:)",
      "fields": {
        "node_id": "string",
        "name": "string",
        "subject": "string",
        "level": "integer",
        "node_catalog_version": "string"
      }
    },
    "QCoreQuestionRevision": {
      "owner": "qcore",
      "identity": ["question_id", "revision_id"],
      "fields": {
        "question_id": "uuid",
        "revision_id": "uuid",
        "published": "boolean",
        "revision_number": "integer"
      }
    },
    "QuestionNodeMapping": {
      "owner": "qcore_derived",
      "identity": ["question_id", "revision_id", "mapping_version", "node_id", "role"],
      "fields": {
        "question_id": "uuid",
        "revision_id": "uuid",
        "mapping_version": "string",
        "node_id": "string",
        "role": "primary|secondary|supporting",
        "parent_primary_node_id": "string|null",
        "confidence": "number 0..1",
        "evidence_quote": "string",
        "source_run_id": "string",
        "created_at": "timestamp"
      }
    },
    "DTLearningObjective": {
      "owner": "deeptutor",
      "identity": ["path_id", "kp_id"],
      "fields": {
        "path_id": "string",
        "kp_id": "string",
        "name": "string",
        "knowledge_type": "memory|concept|procedure|design",
        "module_id": "string",
        "prerequisite_kp_ids": ["string"]
      }
    },
    "DTObjectiveNodeLink": {
      "owner": "integration",
      "identity": ["path_id", "kp_id", "canonical_node_id", "mapping_version"],
      "fields": {
        "path_id": "string",
        "kp_id": "string",
        "canonical_node_id": "string",
        "relation": "primary|secondary|supporting|prerequisite",
        "mapping_version": "string",
        "confidence": "number 0..1",
        "source": "qcore_mapping|human_curated|imported",
        "created_at": "timestamp"
      },
      "cardinality": {
        "kp_to_nodes": "many-to-many",
        "node_to_kps": "many-to-many"
      }
    },
    "DTLearningEvidence": {
      "owner": "deeptutor",
      "identity": "evidence_id",
      "fields": {
        "evidence_id": "string",
        "question_id": "string",
        "revision_id": "string",
        "source_type": "qcore|notebook|...",
        "knowledge_point_id": "string (local, may be empty)",
        "attempt_id": "string",
        "result": "correct|incorrect|partial|ungraded",
        "quality": "number|null",
        "timestamp": "timestamp"
      }
    },
    "EvidenceMappingBinding": {
      "owner": "integration",
      "identity": "evidence_id",
      "fields": {
        "evidence_id": "string",
        "question_id": "string",
        "revision_id": "string",
        "mapping_version": "string|null",
        "canonical_node_ids": ["string"],
        "role_by_node": "object",
        "bound_at": "timestamp"
      }
    },
    "CanonicalMasteryProjection": {
      "owner": "integration_read_only",
      "identity": ["learner_id", "canonical_node_id", "mapping_version", "as_of"],
      "fields": {
        "learner_id": "string",
        "canonical_node_id": "string",
        "mapping_version": "string",
        "as_of": "timestamp",
        "evidence_count": "integer",
        "correct_count": "integer",
        "partial_count": "integer",
        "incorrect_count": "integer",
        "mastery_score": "number|null",
        "source_paths": ["string"]
      }
    },
    "ErrorEvidenceProjection": {
      "owner": "integration_read_only",
      "identity": "error_event_id",
      "fields": {
        "error_event_id": "string",
        "origin_type": "conversation|external_import|document_analysis|qcore",
        "source_type": "qcore|notebook|...",
        "question_id": "string",
        "revision_id": "string",
        "attempt_id": "string",
        "error_type": "structural|deviation|application|metacognitive",
        "grading_source": "system|teacher|self",
        "mastery_path_id": "string",
        "knowledge_point_id": "string",
        "canonical_node_ids": ["string"]
      }
    }
  },
  "invariants": [
    "canonical_node_id must exist in the specified node_catalog_version",
    "knowledge_point_id and canonical_node_id are separate identities",
    "a kp_id may link to zero or more canonical nodes and a canonical node to zero or more kp_ids",
    "the same evidence is counted once per attempt, regardless of how many canonical nodes it maps to",
    "each evidence retains question_id, revision_id, source_type, and attempt_id when available",
    "each canonical mastery projection records mapping_version and as_of",
    "historical evidence is never silently reinterpreted under a newer mapping version",
    "ungraded evidence is excluded from correctness, error, and mastery calculations",
    "qcore and deeptutor never write each other's authoritative facts"
  ],
  "dedupe_key": [
    "source_type",
    "question_id",
    "revision_id",
    "attempt_id"
  ],
  "mastery": {
    "policy": "deeptutor.learning.mastery.compute_mastery",
    "scope": "per learner per canonical_node_id per mapping_version",
    "source": "read-only projection over DT evidence + EvidenceMappingBinding",
    "does_not_write": [
      "LearningProgress.mastery_levels",
      "RepetitionState",
      "ReviewTask"
    ]
  },
  "ownership": {
    "qcore": [
      "knowledge nodes",
      "questions",
      "revisions",
      "publication state",
      "QuestionNodeMapping",
      "mapping versions"
    ],
    "deeptutor": [
      "MasteryPath",
      "LearningModule",
      "KnowledgePoint",
      "QuizAttempt",
      "LearningEvidence",
      "ErrorRecord",
      "mastery",
      "SRS"
    ],
    "integration": [
      "DTObjectiveNodeLink",
      "EvidenceMappingBinding",
      "CanonicalMasteryProjection",
      "ErrorEvidenceProjection"
    ]
  },
  "non_goals": [
    "replacing DT KnowledgePoint.id with QCore node_id",
    "creating a second mastery/evidence store in QCore",
    "using RAG graphs as the canonical subject knowledge graph",
    "merging native notebook question_id with QCore question_id",
    "retroactively relabeling evidence under a new mapping version"
  ]
}
